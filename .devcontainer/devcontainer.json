{
  "name": "lead-generation",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pip install --quiet -e '.[dev]' && ([ -f .env ] || cp .env.example .env)",
  "postStartCommand": "bash .devcontainer/start-ui.sh",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Interface", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
